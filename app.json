{
  "expo": {
    "name": "منشأة العمار",
    "slug": "manshaet-el-ammar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "manshaetelammar",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": ["ar"]
      },
      "bundleIdentifier": "com.ahmedalianz.manshaetelammar"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.ahmedalianz.manshaetelammar",
      "googleServicesFile": "./google-services.json",
      "versionCode": 7,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.CALL_PHONE",
        "android.permission.WRITE_CONTACTS"
      ],
      "icon": "./assets/images/app-icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": {
            "ios": ["ar"],
            "android": ["ar"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/brand-logo.png",
            "imageWidth": 180
          },
          "ios": {
            "image": "./assets/images/splash-screen.png",
            "backgroundColor": "#EAF5FA",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover"
          }
        }
      ],
      "expo-system-ui",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "اختار صورة لمكان خدمتك عشان أهل البلد يعرفوه.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      "./plugins/withOptionalPortrait",
      [
        "expo-contacts",
        {
          "contactsPermission": "اختار جهة اتصال لملء اسم ورقم مقدم الخدمة."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e2f0e241-c1d3-46f8-b356-e1e21ba04740"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": "e2f0e241-c1d3-46f8-b356-e1e21ba04740"
      }
    },
    "owner": "ahmedalianz"
  }
}
