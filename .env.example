# Existing project: manshyat-amar. Retrieve the public API key from google-services.json.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=manshyat-amar.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=manshyat-amar
EXPO_PUBLIC_FIREBASE_APP_ID=1:289986720924:android:89fe100ebd8c6f0584a959

# Google OAuth WEB client (type 3 in google-services.json); public client ID, not a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=289986720924-oad6n2gh68vrq6mscinlu282v9hnnf0n.apps.googleusercontent.com
# Required only for a separately registered iOS app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional development-only emulator routing; false uses the configured project above.
# For isolated tests use project ID demo-manshaet; see docs/firebase-setup.md.
EXPO_PUBLIC_FIREBASE_USE_EMULATORS=false
# Android Studio emulator: 10.0.2.2; web/iOS simulator: 127.0.0.1.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
